    {
      "type": "text",
      "id": "note_identity",
      "x": 60,
      "y": 650,
      "width": 1400,
      "height": 104,
      "text": "One identity travels the whole way: Keycloak signs it once at login, and every later hop (the OBO\ntoken, the GitHub token) still traces back to that same sub. agent1 never sees a GitHub credential.\nagent2 never logs anyone into the realm and never checks a password - it only reads what Keycloak\nalready verified. It does face the browser once, to run the GitHub App consent leg on the user's behalf.",
      "originalText": "One identity travels the whole way: Keycloak signs it once at login, and every later hop (the OBO\ntoken, the GitHub token) still traces back to that same sub. agent1 never sees a GitHub credential.\nagent2 never logs anyone into the realm and never checks a password - it only reads what Keycloak\nalready verified. It does face the browser once, to run the GitHub App consent leg on the user's behalf.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 6200,
      "version": 1,
      "versionNonce": 6201,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "lineHeight": 1.4
    },
