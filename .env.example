# Copy to .env before "docker compose up". Dev values only. Not for production.

# Client secrets. These must match keycloak/realm-export.json.
ORCHESTRATOR_SECRET=orchestrator-dev-secret
REPO_AGENT_SECRET=repo-agent-dev-secret

# Dev signing keys. Any string is fine for the demo.
SESSION_SECRET=dev-session-secret-change-me
REPO_AGENT_TICKET_KEY=dev-ticket-key-change-me
# The repository agent uses this to post Auth Arcade events to the orchestrator agent.
EVENTS_KEY=dev-events-key-change-me

# Leg 3 target. "mock" needs no network. "github" needs a real GitHub App.
MCP_MODE=mock

# Only needed when MCP_MODE=github. Pre-register a GitHub App with callback
# http://localhost:9002/github/callback and paste its client id and secret here.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
